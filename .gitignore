# Build output and Python caches
/dist/
/build/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
gschemas.compiled

# Local configuration and diagnostics
.env
.env.*
!.env.example
*.log
*.swp
*~
.DS_Store
.idea/
.vscode/

# Keep only the current, reviewed product screenshots in source control.
/screenshots/*.png
!/screenshots/hero-dark.png
!/screenshots/hero-light.png
!/screenshots/shot-annotate.png
!/screenshots/shot-detect.png
!/screenshots/shot-pin.png
!/screenshots/shot-prefs.png
