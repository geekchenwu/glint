#!/bin/sh
# Glint @VERSION@ installer. Dependencies are resolved by APT before setup.
set -eu

case "${1:-}" in
  ''|--check) ;;
  --extract)
    [ "$#" -eq 2 ] || { echo "Usage: $0 --extract DIRECTORY" >&2; exit 2; } ;;
  *) echo "Usage: $0 [--check | --extract DIRECTORY]" >&2; exit 2 ;;
esac

script=$(realpath -- "$0")
work=$(mktemp -d "${TMPDIR:-/tmp}/glint-installer.XXXXXX")
trap 'rm -rf "$work"' EXIT HUP INT TERM
package="$work/glint_@VERSION@_all.deb"
payload=$(awk '/^__GLINT_DEB_PAYLOAD__$/ { print NR + 1; exit }' "$script")
[ -n "$payload" ] || { echo "Incomplete Glint installer." >&2; exit 1; }
tail -n +"$payload" "$script" | base64 --decode > "$package"
printf '%s  %s\n' '@SHA256@' "$package" | sha256sum --check --status
dpkg-deb --info "$package" >/dev/null

if [ "${1:-}" = "--extract" ]; then
  mkdir -p -- "$2"
  target="$2/$(basename "$package")"
  if [ -e "$target" ] && ! cmp -s "$package" "$target"; then
    echo "Refusing to replace $target" >&2
    exit 1
  fi
  cp -- "$package" "$target"
  echo "$target"
  exit 0
fi

if [ "${1:-}" = "--check" ]; then
  /usr/bin/apt-get --simulate install "$package"
  exit 0
fi

# APT's unprivileged downloader must be able to read this public package.
chmod 755 "$work"
chmod 644 "$package"
echo "Installing Glint @VERSION@ and its required dependencies..."
if [ "$(id -u)" -eq 0 ]; then
  /usr/bin/apt-get -y --no-remove -o DPkg::Lock::Timeout=60 install "$package"
elif command -v pkexec >/dev/null 2>&1 && [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
  pkexec /usr/bin/apt-get -y --no-remove -o DPkg::Lock::Timeout=60 install "$package"
else
  sudo /usr/bin/apt-get -y --no-remove -o DPkg::Lock::Timeout=60 install "$package"
fi

if [ "$(id -u)" -ne 0 ] && [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
  /usr/share/glint/glint activate
else
  echo "Glint is installed. Open Glint from the applications menu to start."
fi
exit 0
__GLINT_DEB_PAYLOAD__
